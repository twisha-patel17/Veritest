
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  passwordHash    String
  refreshSessions RefreshSession[]
  projects        Project[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id            String         @id @default(cuid())
  name          String
  description   String?        @db.Text
  language      String
  framework     String?
  userId        String
  sourceFiles   SourceFile[]
  testCases     TestCase[]
  testRuns      TestRun[]
  mutationRuns  MutationRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SourceFile {
  id           String         @id @default(cuid())
  projectId    String
  fileName     String
  filePath     String
  content      String         @db.Text
  language     String
  mutationRuns MutationRun[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, filePath])
  @@index([projectId])
}

model TestCase {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  testCode    String   @db.Text
  sourceFile  String?
  origin      String   @default("AI")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results       TestResult[]
  mutantsKilled Mutant[] @relation("MutantKilledBy")

  @@index([projectId])
  @@index([status])
}

model TestRun {
  id           String    @id @default(cuid())
  projectId    String
  status       String    @default("PENDING")
  totalTests   Int       @default(0)
  passedTests  Int       @default(0)
  failedTests  Int       @default(0)
  skippedTests Int       @default(0)
  duration     Int?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@index([projectId, createdAt])
  @@index([status])
}

model TestResult {
  id         String @id @default(cuid())
  testRunId  String
  testCaseId String

  status String

  duration Int?
  exitCode Int?

  stdout       String? @db.Text
  stderr       String? @db.Text
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  testRun  TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  failure Failure?

  @@unique([testRunId, testCaseId])
  @@index([testCaseId])
}

model Failure {
  id           String @id @default(cuid())
  testResultId String @unique

  type         String
  title        String
  errorMessage String? @db.Text
  stackTrace   String? @db.Text

  stdout String? @db.Text
  stderr String? @db.Text

  failingInput String? @db.Text
  expected     String? @db.Text
  actual       String? @db.Text

  status String @default("UNCONFIRMED")

  reproductionAttempts ReproductionAttempt[]

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ReproductionAttempt {
  id        String @id @default(cuid())
  failureId String

  attemptNumber Int
  status        String

  errorMessage String? @db.Text
  stackTrace   String? @db.Text

  duration Int?

  failure Failure @relation(fields: [failureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([failureId, attemptNumber])
  @@index([failureId])
}

model MutationRun {
  id           String   @id @default(cuid())
  projectId    String
  sourceFileId String

  status String @default("PENDING")

  totalMutants        Int @default(0)
  killedMutants       Int @default(0)
  survivedMutants     Int @default(0)
  equivalentMutants   Int @default(0)
  inconclusiveMutants Int @default(0)

  mutationScore Float?
  duration      Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFile SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  mutants Mutant[]

  @@index([projectId, createdAt])
  @@index([sourceFileId])
  @@index([status])
}

model Mutant {
  id            String @id @default(cuid())
  mutationRunId String

  operator    String
  description String
  lineNumber  Int?

  originalCode String @db.Text
  mutatedCode  String @db.Text

  status String @default("PENDING")

  killedByTestCaseId String?
  duration           Int?

  errorMessage String? @db.Text
  stdout       String? @db.Text
  stderr       String? @db.Text

  createdAt DateTime @default(now())

  mutationRun MutationRun @relation(fields: [mutationRunId], references: [id], onDelete: Cascade)

  killedByTestCase TestCase? @relation(
    "MutantKilledBy",
    fields: [killedByTestCaseId],
    references: [id],
    onDelete: SetNull
  )

  @@index([mutationRunId])
  @@index([status])
  @@index([killedByTestCaseId])
}
